{
  "name": "nutka",
  "version": "0.0.1",
  "description": "Open-source music in your terminal.",
  "type": "module",
  "private": true,
  "bin": {
    "nutka": "src/index.ts"
  },
  "scripts": {
    "dev": "bun run scripts/run.ts",
    "dev:apple": "bun run scripts/dev-apple.ts",
    "playback:probe": "bun --no-env-file run scripts/probe-apple-playback.ts",
    "signer:dev": "bun run --cwd services/apple-token dev -- --ip 127.0.0.1 --port 8788",
    "signer:check": "bun run --cwd services/apple-token check",
    "signer:deploy": "bun run --cwd services/apple-token deploy",
    "start": "bun run scripts/run.ts",
    "test": "bun test src scripts",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test && bun run signer:check"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "license": "MIT",
  "dependencies": {
    "@opentui/core": "^0.5.8",
    "puppeteer-core": "^25.9.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
