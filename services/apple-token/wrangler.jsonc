{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nutka-apple-token",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "workers_dev": true,
  "vars": {
    "APPLE_TOKEN_TTL_SECONDS": "900"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
