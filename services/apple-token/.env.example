NUTKA_TOKEN_SERVICE_MODE=mock
NUTKA_TOKEN_SERVICE_HOST=127.0.0.1
NUTKA_TOKEN_SERVICE_PORT=8787
NUTKA_RATE_LIMIT_PER_MINUTE=30

# Required only when NUTKA_TOKEN_SERVICE_MODE=apple
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
# APPLE_PRIVATE_KEY may be used instead of APPLE_PRIVATE_KEY_PATH.

# Optional. Restricts browser-origin requests when it is set.
NUTKA_ALLOWED_ORIGIN=
APPLE_TOKEN_TTL_SECONDS=900
